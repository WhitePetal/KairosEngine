/target
# Run logs written by `kairos_log` (any editor/engine run creates them).
/Library/Logs
# Profiler captures written by `Profiler::save_capture` (runtime artifacts).
/Library/Profiler
# The asset processor's write-ahead log (the processed assets under
# `Library/imported_assets/Default` are committed; regenerate them from the
# project sources with `cargo run --bin bake_assets`).
/Library/imported_assets/log
