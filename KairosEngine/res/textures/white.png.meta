(
    meta_format_version: "1.0",
    asset: Process(
        processor: "kairos_graphics::texture::TextureProcessor",
        settings: (
            width: 2,
            height: 2,
            format: Rgba8Unorm,
            sampler: (
                filter_mode: Linear,
                address_mode_u: Repeat,
                address_mode_v: Repeat,
                address_mode_w: Repeat,
                mipmap: Some((
                    filter: Linear,
                    anisotropy_clamp: 2,
                    lod_min_clamp: 0.0,
                    lod_max_clamp: 1.0,
                )),
                compare: None,
                border_color: None,
            ),
        ),
    ),
)