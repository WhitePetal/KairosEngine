source_path = "res/materials/gizmos/grid_plane.mat"
shader_path = "res/shaders/gizmos/grid_plane.wgsl"

[render_state]
depth_test = "LessEqual"
depth_write = false
cull_mod = "Back"
topology = "LineList"

[render_state.blend_mod.color]
src_factor = "SrcAlpha"
dst_factor = "OneMinusSrcAlpha"
operation = "Add"

[render_state.blend_mod.alpha]
src_factor = "One"
dst_factor = "OneMinusSrcAlpha"
operation = "Add"
